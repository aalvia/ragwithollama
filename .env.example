# AquaRAG. Copia este archivo a .env antes de ejecutar.
# En Windows, 127.0.0.1 evita que localhost resuelva a IPv6 y falle la conexión.

OLLAMA_BASE_URL=http://127.0.0.1:11434

# Modelo de respuestas. Esta instalación usa qwen2.5:1.5b porque el equipo
# de destino no tiene VRAM. qwen2.5:7b es la variante mayor: se cambia esta
# línea y se descarga el modelo, sin modificar el código.
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_TOKENS=700

CHROMA_DB_PATH=./data/chroma_db
DOCUMENTS_PATH=./data/documents
INDEX_STATE_PATH=./data/index_state.json

CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5

# Distancia máxima en el espacio coseno de ChromaDB. Más bajo exige más parecido.
# En este corpus, las preguntas del tema quedaron cerca de 0,15 a 0,29 y las
# preguntas ajenas empezaron alrededor de 0,32. Si una pregunta válida queda
# sin respuesta, sube el valor con cuidado y reinicia.
MAX_DISTANCE=0.30

# false: cada pregunta se responde sola, solo con los fragmentos recuperados.
# true: el servidor recuerda los últimos turnos de la sesión del navegador.
# Hay que reiniciar la aplicación después de cambiar este valor.
CONVERSATION_CONTEXT=false
CONVERSATION_MAX_TURNS=4
